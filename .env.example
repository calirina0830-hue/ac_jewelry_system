# Supabase Project URL and publishable key from Project Settings > API.
# The publishable key is safe for browser use and remains protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Canonical application origin used in authentication email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only mapping from the public administrator username to the email used
# internally by Supabase Auth. Never prefix these with NEXT_PUBLIC.
ADMIN_LOGIN_USERNAME=adminrina
ADMIN_LOGIN_EMAIL=adminrina@your-company-domain.com
